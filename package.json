{
  "name": "merge-avec-contexte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Merge check Bitbucket qui évalue le contexte (ticket Jira, gels, incidents) avant fusion — Codegeist 2026.",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "shared:sync": "node scripts/shared-sync.mjs sync",
    "shared:check": "node scripts/shared-sync.mjs check",
    "hooks:install": "node scripts/shared-sync.mjs hooks",
    "prepare": "node scripts/shared-sync.mjs hooks --quiet",
    "lint": "node tools/check-style.mjs",
    "manifests": "node tools/check-manifests.mjs && node tools/check-manifest-schema.mjs",
    "limits": "python3 tools/check-file-limits.py && node tools/check-function-limits.mjs",
    "verify": "npm run shared:check && npm run lint && npm run typecheck && npm test && npm run limits",
    "deploy": "node scripts/deploiement.mjs",
    "demo": "vite-node scripts/preuve-reelle.ts",
    "preuve:captures": "vite-node scripts/preuve-captures.ts",
    "preuve:verifier": "vite-node scripts/preuve-verifier.ts",
    "preuve:bitbucket": "vite-node scripts/preuve-bitbucket.ts",
    "preuve:publier": "vite-node scripts/publier-preuve.ts",
    "demo:fictif": "vite-node scripts/demo-entree.ts",
    "installer:espace": "node scripts/installer-espace-bitbucket.mjs"
  },
  "devDependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/manifest": "^13.9.0",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.10",
    "@forge/storage": "^2.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "jsdom": "^31.0.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
